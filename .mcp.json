{
  "mcpServers": {
    "playwright": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "playwright",
        "mcp",
        "--headless",
        "--browser",
        "msedge",
        "--isolated",
        "--output-dir",
        ".playwright-mcp",
        "--blocked-origins",
        "https://wpmbumtpcuahyqmdeqgf.supabase.co"
      ]
    },
    "playwright-test": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "playwright",
        "run-test-mcp-server",
        "--headless",
        "-c",
        "playwright.config.ts"
      ]
    },
    "supabase-test": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@supabase/mcp-server-supabase@0.12.0",
        "--project-ref=akhkukajdgayqwhedeoo",
        "--features=database,docs"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "${SUPABASE_ACCESS_TOKEN}"
      }
    }
  }
}
